# Optional: Set a dedicated backend wallet as initial logger during deployment
LOGGER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Local node RPC URL used by hardhat.config.js
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Required for Sepolia deployment
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional but recommended for source verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
